# specargo 框架级配置（复制为 .env 后按需填写；.env 不要进版本库）
#
# 环境变量契约统一使用 PIPELINE_ 前缀；旧前缀（见 app/envcompat.py）
# 仍兼容读取一个版本，新配置请只用新名。

# ---- 状态与批次 ----
PIPELINE_STATE_DB=                 # item 状态库（SQLite）；不填则不登记
PIPELINE_RUN_ID=                   # 批次 ID；集群里由编排层注入（{{workflow.name}}）

# ---- Argo 输出参数（本地联调用）----
PIPELINE_ARGO_OUTPUTS=0            # 1 = 强制写 Argo 输出参数，便于本地验证工作流契约
PIPELINE_ARGO_OUTPUT_DIR=          # 输出根目录（覆盖 /argo/outputs）
PIPELINE_ARGO_PARAM_DIR=           # 参数输出目录（本地联调）
PIPELINE_ARGO_ARTIFACT_DIR=        # artifact 输出目录（本地联调）

# ---- 对象存储（objstore CLI / 本地演练）----
OBJSTORE_KIND=local                # local | s3
OBJSTORE_ROOT=./artifacts          # local 模式的根目录
OBJSTORE_ENDPOINT=                 # s3 模式端点（MinIO/OSS/S3）
OBJSTORE_BUCKET=argo-artifacts
OBJSTORE_ACCESS_KEY=
OBJSTORE_SECRET_KEY=

# ---- 告警通道（可选）----
NOTIFY_WEBHOOK=                    # 钉钉/飞书/Slack webhook；不配则只打日志
