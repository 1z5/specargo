# 密钥与配置（复制为 .env 后填写；.env 不要进版本库）
# 对应 app/config.py 的 Config.from_env()

# OpenAI TTS
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=                 # 走代理/兼容网关时填

# 音色与格式
TTS_VOICE_MALE=cedar
TTS_VOICE_FEMALE=marin
TTS_VOICE_TEST=cedar
TTS_FORMAT=mp3
TTS_SPEED=1.0
TTS_RATE=+0%
TTS_PITCH=+0Hz
TTS_VOLUME=+0%

# 路径（容器内由 workflow.yaml 的 env 覆盖）
TTS_OUTPUT_DIR=./output
TTS_BOOKS_DIR=./全部书籍

# 改造新增项
TTS_RUN_ID=                      # 批次 ID；Argo 里传 {{workflow.name}}
TTS_STATE_DB=                    # item 状态库（SQLite）；不填则不登记
TTS_MAX_RETRIES=3                # 容器内重试次数；迁到 Argo 后建议设 1，交给 retryStrategy
TTS_ARGO_OUTPUTS=0               # 1 = 强制写 Argo 输出参数（本地联调用）
TTS_ARGO_PARAM_DIR=              # 本地联调时参数输出目录
TTS_ARGO_ARTIFACT_DIR=           # 本地联调时 artifact 输出目录
NOTIFY_WEBHOOK=                  # 钉钉/飞书/Slack webhook；不配则只打日志
