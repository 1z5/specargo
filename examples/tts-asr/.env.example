# examples/tts-asr 领域示例配置（复制为 .env 后填写；.env 不要进版本库）

# ---- 生成端 ----
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=                 # 走代理/兼容网关时填
TTS_MAX_RETRIES=3                # 容器内重试次数；迁到 Argo 后建议设 1，交给 retryStrategy

# ---- 音色与格式 ----
TTS_VOICE_MALE=cedar
TTS_VOICE_FEMALE=marin
TTS_VOICE_TEST=cedar
TTS_FORMAT=mp3
TTS_SPEED=1.0
TTS_RATE=+0%
TTS_PITCH=+0Hz
TTS_VOLUME=+0%

# ---- 路径 ----
TTS_OUTPUT_DIR=./output
TTS_BOOKS_DIR=./data

# ---- 框架级（也可用旧的 TTS_ 前缀，见仓库根 app/envcompat.py）----
PIPELINE_RUN_ID=
PIPELINE_STATE_DB=
PIPELINE_ARGO_OUTPUTS=0
PIPELINE_ARGO_PARAM_DIR=
PIPELINE_ARGO_ARTIFACT_DIR=
NOTIFY_WEBHOOK=
